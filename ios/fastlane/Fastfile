default_platform(:ios)

def app_store_api_key_from_env
  app_store_connect_api_key(
    key_id: ENV.fetch("APPSTORE_API_KEY_ID"),
    issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
    key_content: ENV.fetch("APPSTORE_API_PRIVATE_KEY"),
    is_key_content_base64: false,
    in_house: false
  )
end

platform :ios do
  desc "Sync App Store signing assets with match"
  lane :sync_signing do
    setup_ci if ENV["CI"]

    match(
      api_key: app_store_api_key_from_env,
      type: "appstore",
      readonly: ENV["MATCH_READONLY"] == "true",
      generate_apple_certs: true
    )
  end

  desc "Upload an IPA to TestFlight"
  lane :upload_testflight do |options|
    ipa_path = options[:ipa].to_s
    UI.user_error!("Missing ipa path") if ipa_path.empty?

    upload_to_testflight(
      api_key: app_store_api_key_from_env,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
