rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function canReadStory(uid) {
      return signedIn() && (
        isOwner(uid) ||
        isAdmin() ||
        resource.data.uid == request.auth.uid ||
        resource.data.isPublic == true
      );
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow read: if signedIn();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      match /chatLogs/{chatLogId} {
        allow read, create, update, delete: if isOwner(uid) || isAdmin();

        match /stories/{storyId} {
          allow read: if canReadStory(uid);
          allow create, update, delete: if isOwner(uid) || isAdmin();
        }
      }

      match /favoriteStories/{storyId} {
        allow read, create, update, delete: if isOwner(uid) || isAdmin();
      }

      match /consumables/{purchaseId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }
  }
}
